{
  "name": "angular-shop",
  "version": "1.2",
  "scripts": {
    "ng": "ng",
    "start:client": "ng serve --port 3000",
    "start:server": "cd server && npm run start",
    "server": "node dist/angular-shop/server/server.mjs",
    "start:angular-server": "node --loader ts-node/esm server.ts",
    "open:chrome": "npx open-cli http://localhost:3000 --app chrome",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-shop": "node dist/angular-shop/server/server.mjs",
    "lint": "ng lint",
    "start": "concurrently \"npm run start:client\" \"npm run start:server\"",
    "install": "npm install && cd server && npm install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.8",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.8",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.4",
    "@monei-js/components": "^1.7.4",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@popperjs/core": "^2.11.8",
    "@stripe/stripe-js": "^4.9.0",
    "bootstrap": "^5.3.3",
    "express": "^4.18.2",
    "jquery": "^3.7.1",
    "ngx-owl-carousel-o": "^18.0.0",
    "rxjs": "~7.8.0",
    "sitemap": "^8.0.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.4",
    "@angular/cli": "^18.2.4",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/localize": "^18.2.4",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/stripe-v3": "^3.1.33",
    "angular-eslint": "19.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.18.0"
  },
  "overrides": {
    "http-proxy-middleware": "^3",
    "vite": "^5.4.5",
    "rollup": "^4.23.0"
  }
}
